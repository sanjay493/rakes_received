{
  "manifest_version": 3,
  "name": "Rakes Received Exporter",
  "version": "1.8.0",
  "description": "Sends FOIS rake tables to the Rakes Received dashboard, fetches BOBSNM1 rake trips, and can resend the Loaded In-Bound list.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:5000/*", "https://rakes-received.fly.dev/*", "https://rbs.indianrail.gov.in/*", "https://fois.indianrail.gov.in/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send rake table",
    "default_popup": "popup.html"
  }
}
